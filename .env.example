# Copy this file to .env and adjust as needed for local (non-docker) development.
# docker-compose.yml sets these same variables directly for containers.

NODE_ENV=development

# API
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/taskflow

# Redis (used by BullMQ for queue coordination)
REDIS_HOST=localhost
REDIS_PORT=6379

# BullMQ queue name
QUEUE_NAME=taskflow-jobs

# Retry configuration
DEFAULT_MAX_ATTEMPTS=3
BACKOFF_DELAY_MS=1000

# Frontend
VITE_API_URL=http://localhost:4000

# --- docker-compose only: host port overrides (leave unset to use defaults) ---
# Change these if the default ports are already in use on your machine.
# API_PORT=4000
# FRONTEND_PORT=5173
# MONGO_PORT=27017
# REDIS_PORT=6379
